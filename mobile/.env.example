# The live address is already set in .env.development (used by `expo start` and run-mobile.sh) and
# .env.production (release builds). To use another server on your own computer, copy this file to
# .env.local (it is not in git) and edit the address below: a value there wins.
#
# Absolute URL of the MoodCircle API, including "/api" and any BASE_PATH, no trailing slash.
# Inlined into the app at build time and visible inside it: never put a secret here.
# A phone cannot reach your computer's "localhost": use the computer's LAN IP for a dev
# server, or the deployed HTTPS URL. (scripts/verify-web.mjs sets "/api" itself.)
EXPO_PUBLIC_API_URL=https://your-domain.example/api

# Optional. Where "Terms" and "Privacy Policy" on the sign-up screen point. Left empty, the words
# are shown as plain text (there is nothing to open yet). Must be https:// or http:// addresses.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
