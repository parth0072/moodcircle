# Absolute URL of the MoodCircle API, including "/api" and any BASE_PATH, no trailing slash.
# Inlined into the app at build time and visible inside it: never put a secret here.
# A phone cannot reach your computer's "localhost": use the computer's LAN IP for a dev
# server, or the deployed HTTPS URL. (scripts/verify-web.mjs sets "/api" itself.)
EXPO_PUBLIC_API_URL=https://your-domain.example/api
