# The live MoodCircle server the app talks to while you develop (`expo start`, run-mobile.sh).
# The address is not a secret: it is inlined into the app and visible inside it. Never put a secret here.
# To try something else on your own computer, put EXPO_PUBLIC_API_URL in .env.local (it is not in git),
# or run `bash run-mobile.sh --local` for a throwaway test server.
EXPO_PUBLIC_API_URL=https://api.alphabyteinnovation.com/moodcircle/api
